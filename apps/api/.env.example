# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://koli:CHANGE_ME@localhost:5432/koli

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_64_BYTE_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# ─── AWS S3 / MinIO ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=eu-central-1
AWS_S3_BUCKET=koli-media
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_PRESIGN_EXPIRES=300

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# ─── Meilisearch ──────────────────────────────────────────────────────────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=CHANGE_ME

# ─── SMTP / E-posta ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME
MAIL_FROM_NAME=Koli
MAIL_FROM_ADDRESS=noreply@example.com

# ─── iyzico ───────────────────────────────────────────────────────────────────
IYZICO_API_KEY=sandbox-CHANGE_ME
IYZICO_SECRET_KEY=sandbox-CHANGE_ME
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
