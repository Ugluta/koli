# ─── Koli Production — Ortam Değişkenleri ─────────────────────────────────────
# Bu dosyayı .env olarak kopyalayın ve tüm değerleri doldurun.
# cp .env.example .env

# ─── Site URL'leri ─────────────────────────────────────────────────────────────
SITE_URL=https://koli.example.com
FRONTEND_URL=https://koli.example.com
NEXT_PUBLIC_API_URL=https://koli.example.com/api/v1
ALLOWED_ORIGINS=https://koli.example.com

# ─── Veritabanı ────────────────────────────────────────────────────────────────
# openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── JWT ───────────────────────────────────────────────────────────────────────
# openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_64_BYTE_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Meilisearch ───────────────────────────────────────────────────────────────
# openssl rand -hex 32
MEILI_MASTER_KEY=CHANGE_ME_STRONG_PASSWORD

# ─── MinIO (Dosya Depolama) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AWS_REGION=eu-central-1
AWS_S3_BUCKET=koli-media
AWS_S3_PRESIGN_EXPIRES=300

# ─── SMTP (E-posta) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME
MAIL_FROM_NAME=Koli
MAIL_FROM_ADDRESS=noreply@example.com

# ─── iyzico (Ödeme — opsiyonel) ────────────────────────────────────────────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
